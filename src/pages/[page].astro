---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import site from '../content/site.json';
import { pages } from '../content/pages';
import { showcases, workflow } from '../content/content';
export function getStaticPaths() {
  return Object.entries(pages).map(([page, content]) => ({
    params: { page },
    props: { content },
  }));
}
const { content } = Astro.props;
const { page } = Astro.params;
const inquiry =
  'My design question:\n\nWhat I want to compare:\n\nThe decision this would inform:\n\nOperating system and GPU (if known):\n\nOptional work contact:';
---

<Layout title={content.title} description={content.description}>
  <div class="container">
    <header class="page-hero">
      <h1>{content.title}</h1>
      <p>{content.description}</p>
    </header>
    <div class="page-container">
      {page === 'showcases' && (
        <>
          <div class="showcase-grid">
            {showcases.map((item) => (
              <ShowcaseCard item={item} />
            ))}
          </div>
          <p class="notice">
            Candidate studies are not validated applications. No public
            numerical dataset, benchmark, or product screenshot is represented
            by these illustrations.
          </p>
          <a href="/validation/" class="text-link">
            Read our approach to evidence <Icon />
          </a>
        </>
      )}
      {page === 'download' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>Not quite on your desktop. Yet.</h2>
            <p>
              No public build has been approved for download. When one is ready,
              each installer will include its version, requirements, release
              notes, file size, and checksum.
            </p>
            <a class="text-link" href="/support/#early-access">
              About early access <Icon />
            </a>
          </div>
          <div class="platform-grid">
            {['Windows', 'Linux', 'macOS'].map((platform) => (
              <article class="platform-card">
                <Icon name="desktop" size={28} />
                <h3>{platform}</h3>
                <p>No qualified public release is available.</p>
                <span class="tag">Support not announced</span>
              </article>
            ))}
          </div>
          <p class="notice">
            Your operating system is a starting point, not a compatibility
            guarantee. GPU, driver, and memory requirements will be published
            for each qualified release.
          </p>
          <div class="article">
            <h2>One product. A deeper workflow when you need it.</h2>
            <p>
              The desktop application is the starting point. Any CLI release
              will be presented as an advanced companion, alongside the matching
              version and requirements.
            </p>
            <p>
              There are no older public versions to list.{' '}
              <a href="/changelog/">View release status.</a>
            </p>
          </div>
        </>
      )}
      {page === 'docs' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>A guide to the idea.</h2>
            <p>
              This is a workflow overview for the design preview. A runnable
              quick start, bundled example, troubleshooting guide, and
              documented hardware requirements will accompany a qualified public
              build.
            </p>
          </div>
          <div class="article">
            <h2>From a question to a next step.</h2>
            {workflow.map((step, index) => (
              <div class="quickstart-step">
                <span>0{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </div>
            ))}
            <h2>When a public build is available</h2>
            <ol>
              <li>
                Choose the qualified installer for your system and check its
                requirements and release notes.
              </li>
              <li>
                Open the bundled example for that version. Inspect the units,
                fluid properties, boundary conditions, and method limitations.
              </li>
              <li>
                Run the example and examine its documented numerical checks
                before interpreting a result.
              </li>
              <li>
                Change one parameter and compare it against the baseline,
                keeping the relevant assumptions consistent.
              </li>
              <li>
                Save your setup and use the version’s documented export options.
                Record the version and assumptions with your findings.
              </li>
            </ol>
            <p>
              For now, you can explore our{' '}
              <a href="/showcases/">candidate study questions</a> and{' '}
              <a href="/validation/">approach to evidence</a>.
            </p>
          </div>
        </>
      )}
      {page === 'support' && (
        <>
          <section
            id="early-access"
            class="info-panel ambient amb-surface amb-chamfer"
          >
            <h2>Start with the decision.</h2>
            <p>
              A short outline of your use case is enough. What are you
              comparing, what behaviour matters, and what decision will the
              study inform? Please leave confidential geometry and project data
              out of an initial inquiry.
            </p>
            {site.contactEmail ? (
              <>
                <a
                  href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Prelimina — discuss my case')}&body=${encodeURIComponent(inquiry)}`}
                  class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
                >
                  Open an email draft <Icon name="diagonal" size={18} />
                </a>
                <p class="contact-email">Email: {site.contactEmail}</p>
                <p class="section-note">
                  Opens your email application. Review and send the message
                  there.
                </p>
              </>
            ) : (
              <p class="notice">
                Early-access inquiries are not open through this preview yet.
                You can prepare an outline below; a public contact address will
                be added when it is confirmed.
              </p>
            )}
            <label for="inquiry" class="contact-label">
              Your case outline — kept in this page only
            </label>
            <textarea
              id="inquiry"
              class="contact-summary"
              spellcheck="true"
            >{inquiry}</textarea>
            <div class="copy-row">
              <button
                id="copy-inquiry"
                type="button"
                class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
              >
                Copy your outline <Icon size={17} />
              </button>
            </div>
            <p id="copy-status" class="copy-status" role="status"></p>
            <p class="section-note">
              Nothing is submitted or saved by this website. Refreshing the page
              clears your outline.
            </p>
          </section>
          <div class="article">
            <h2>Product questions & issue reports</h2>
            <p>
              Include your application version, operating system, GPU and
              driver, the steps you took, and the behaviour you expected. Only
              share logs or a minimal example after checking that they contain
              no confidential information.
            </p>
            <h2>Private project support</h2>
            <p>
              Project-specific help and commercial pilots are scoped by
              agreement. A private support and security-reporting route will be
              published before public release.
            </p>
            <p>No public issue tracker is linked during this preview.</p>
          </div>
        </>
      )}
      {page === 'validation' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>The distinction matters.</h2>
            <p>
              No approved public validation or performance record is published
              on this site yet. The candidate studies describe potential
              questions; they do not establish accuracy or suitability for an
              application.
            </p>
            <p class="section-note">
              Website content reviewed: {site.reviewed}. Product version: no
              public release attached.
            </p>
          </div>
          <div class="article">
            <h2>Implemented capability</h2>
            <p>
              A method or feature exists in the software. That alone does not
              establish convergence, accuracy, or suitability across physical
              regimes.
            </p>
            <h2>Numerical health</h2>
            <p>
              Conservation, residuals, stability, and refinement help assess how
              a particular calculation behaves. Passing one check does not
              replace physical validation.
            </p>
            <h2>Validation for a defined case</h2>
            <p>
              A public case record should connect the model and its assumptions
              to a relevant analytical, experimental, or reference result. It
              should state the application version, method, inputs, metrics, and
              known limitations.
            </p>
            <h2>Performance with context</h2>
            <p>
              Any published timing should identify the hardware, software,
              workload, and measurement method. This preview makes no measured
              speedup claim.
            </p>
            <a class="text-link" href="/showcases/">
              Explore the candidate questions <Icon />
            </a>
          </div>
        </>
      )}
      {page === 'pricing' && (
        <>
          <div class="access-grid">
            {[
              {
                title: 'Learning & research',
                text: 'Eligibility for any free use will be defined in the approved release terms.',
                tag: 'Eligibility to be published',
              },
              {
                title: 'Commercial evaluation',
                text: 'Discuss the decision you need to make and whether an evaluation fits your case.',
                tag: 'By agreement',
              },
              {
                title: 'Professional & pilot',
                text: 'Business access and bounded project support, with scope and terms agreed in advance.',
                tag: 'By agreement',
              },
            ].map((plan) => (
              <article class="platform-card">
                <h3>{plan.title}</h3>
                <p>{plan.text}</p>
                <span class="tag">{plan.tag}</span>
              </article>
            ))}
          </div>
          <p class="notice">
            Prices, evaluation durations, concurrency, and perpetual-use terms
            have not been approved for publication. This preview is not a
            licensing offer.
          </p>
          <a href="/support/#early-access" class="text-link">
            About early conversations <Icon />
          </a>
        </>
      )}
      {page === 'legal' && (
        <div class="article">
          <h2>About this preview</h2>
          <p>
            Prelimina is developed by {site.company}. This preliminary website
            is not a software release, a licensing agreement, or an offer of
            platform support.
          </p>
          <h2>Privacy in this implementation</h2>
          <p>
            The website contains no analytics, advertising cookies, session
            replay, remote fonts, or third-party embeds. The case-outline
            control does not send data to a server; its copy button only writes
            to your clipboard when you use it.
          </p>
          <p>
            A hosting provider may process network request logs.
            Hosting-specific disclosures, the company contact details, and
            approved public privacy and website terms will accompany the public
            product release.
          </p>
          <h2>Software terms</h2>
          <p>
            The public EULA, license schedules, and support terms are not yet
            published here. No draft terms are presented as approved.
          </p>
          <h2>Third-party design assets</h2>
          <p>
            The site uses AmbientCSS under the MIT license and the locally
            hosted Bacasime Antique font under the SIL Open Font License 1.1.
          </p>
          <div class="legal-list">
            <a href="/licenses/AmbientCSS-MIT.txt">AmbientCSS license</a>
            <a href="/licenses/BacasimeAntique-OFL.txt">
              Bacasime Antique license
            </a>
          </div>
        </div>
      )}
      {page === 'changelog' && (
        <div class="info-panel ambient amb-surface amb-chamfer">
          <h2>Prelaunch</h2>
          <p>
            No public product version or installer is attached to this design
            preview.
          </p>
          <a class="text-link" href="/download/">
            Check download availability <Icon />
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
<script>
  const emailLink =
    document.querySelector<HTMLAnchorElement>('a[href^="mailto:"]');
  emailLink?.addEventListener('click', () => {
    const outline = document.querySelector<HTMLTextAreaElement>('#inquiry');
    const address = emailLink.href.split('?')[0];
    emailLink.href = `${address}?subject=${encodeURIComponent('Prelimina — discuss my case')}&body=${encodeURIComponent(outline?.value || '')}`;
  });
  const copy = document.querySelector<HTMLButtonElement>('#copy-inquiry');
  copy?.addEventListener('click', async () => {
    const outline = document.querySelector<HTMLTextAreaElement>('#inquiry');
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (!outline || !status) return;
    try {
      await navigator.clipboard.writeText(outline.value);
      status.textContent = 'Outline copied. Nothing has been sent.';
    } catch {
      outline.focus();
      outline.select();
      status.textContent =
        'Clipboard access is unavailable. Your outline is selected; copy it with your usual keyboard command.';
    }
  });
</script>
