---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import site from '../content/site.json';
import { pages } from '../content/pages';
import {
  access,
  licence,
  licensingAction,
  showcases,
  workflow,
  iteration,
  evidenceGuide,
} from '../content/content';
import { inquiryOutline, inquiryHref } from '../content/inquiry.mjs';
export function getStaticPaths() {
  return Object.entries(pages).map(([page, content]) => ({
    params: { page },
    props: { content },
  }));
}
const { content } = Astro.props;
const { page } = Astro.params;
---

<Layout title={content.title} description={content.description}>
  <div class="container">
    <header class="page-hero">
      <h1>{content.title}</h1>
      <p>{content.description}</p>
    </header>
    <div class="page-container">
      {page === 'showcases' && (
        <>
          <div class="showcase-grid">
            {showcases.map((item) => (
              <ShowcaseCard item={item} />
            ))}
          </div>
          <p class="notice">
            Availability describes application development or release status.
            Evidence describes what you can inspect. An illustration does not
            establish numerical accuracy or physical validation.
          </p>
          <a href="/validation/" class="text-link">
            Inspect the evidence criteria <Icon />
          </a>
        </>
      )}
      {page === 'download' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>Public release status</h2>
            <p>
              No public build has been approved for download. When one is ready,
              each installer will include its version, requirements, release
              notes, file size, and checksum.
            </p>
            <a class="text-link" href={access.primary.href}>
              {access.primary.label} <Icon />
            </a>
          </div>
          <div class="article">
            <h2>Requirements come with the release.</h2>
            <p>
              Operating system, GPU, driver, and memory requirements have not
              been qualified for a public build. A development build path does
              not establish platform support.
            </p>
            <p>
              <a href="/pricing/">Read about access and licensing</a> or{' '}
              <a href="/changelog/">view release status</a>.
            </p>
          </div>
        </>
      )}
      {page === 'docs' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>A workflow in development.</h2>
            <p>
              The native application separates the physical experiment from
              numerical preparation and execution. No public installer is
              attached to this overview.
            </p>
          </div>
          <div class="article">
            {workflow.map((step, index) => (
              <section class="quickstart-step" id={step.id}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h2>{step.title}</h2>
                  <p>
                    <strong>{step.detail}</strong> {step.text}
                  </p>
                </div>
              </section>
            ))}
            <h2>{iteration.title}</h2>
            <p>{iteration.text}</p>
            <h2 id="geometry">Geometry and physical setup</h2>
            <p>
              The development application imports mesh files in STL, OBJ, PLY,
              glTF, and GLB formats. Create geometry in your usual tools and
              check units, orientation, and suitability for the intended fluid
              region. Native CAD history, automatic repair, and retained
              boundary assignments after reimport are not promised.
            </p>
            <p>
              Define the initial liquid, material properties, gravity, and
              prescribed motion. Choose a configuration that supports the
              physical assumptions of your experiment, including the treatment
              of the surrounding gas.
            </p>
            <h2 id="boundaries">Boundary and motion scope</h2>
            <p>
              Boundary support depends on the method and configuration.
              Prescribed tank or body motion is distinct from freely responding
              rigid-body coupling. Saved wall-velocity settings do not establish
              a moving wall: the current FLIP domain-wall colliders remain
              fixed; moving bodies and domain-frame motion are separate
              mechanisms.
            </p>
            <p>
              Selected configurations implement prescribed inflow and domain
              pressure outlets. General inlet/outlet combinations, finite outlet
              surfaces, and moving inlet surfaces still need implementation or
              qualification. Filling and overflow remain a candidate
              application.
            </p>
            <h2 id="measurements">Measurements and exports</h2>
            <p>
              Simulate provides live visualisation and diagnostics. Configured
              pressure and velocity probes record measurements to CSV, with
              availability and units. Field and surface exports use VTK where
              supported by the selected method. Review both numerical
              diagnostics and measurement availability before comparing runs.
            </p>
            <p>
              A pressure probe samples a fluid region; it is not a reconstructed
              wall-pressure tap. Body forces and moments are whole-body
              quantities with method-specific limits. The experimental FLIP
              Wavelet mode does not provide quantitative pressure or
              force/moment measurements. Exported data still needs case-specific
              verification and validation.
            </p>
            <h2 id="numerical-scope">
              Numerical choices have different scopes.
            </h2>
            <p>
              Prepare exposes resolution, time-step, and method settings. The
              FLIP interface starts with Basic controls and offers Advanced and
              Expert detail. FVM and FIRM use different methods and currently
              have less curated settings interfaces. Experimental variants have
              narrower capability and qualification limits. These are
              development paths within one product, not purchasing tiers or
              interchangeable accuracy guarantees.
            </p>
            <p>
              Review <a href="/showcases/">initial applications</a> and the{' '}
              <a href="/validation/">evidence criteria</a> when framing a study.
              A version-specific quick start and platform requirements will
              accompany an approved public release.
            </p>
          </div>
        </>
      )}
      {page === 'support' && (
        <>
          <section
            id="early-access"
            class="info-panel ambient amb-surface amb-chamfer"
          >
            <h2>Start with the decision.</h2>
            <p>
              A short outline of your use case is enough. What are you
              comparing, what behaviour matters, and what decision will the
              study inform? Please leave confidential geometry and project data
              out of an initial inquiry.
            </p>
            {!access.open && (
              <p class="notice">
                Application inquiries are not open through this preview yet. You
                can prepare an outline below; a public application contact
                address will be added when it is confirmed.
              </p>
            )}
            <label for="inquiry" class="contact-label">
              Your case outline — kept in this page only
            </label>
            <textarea
              id="inquiry"
              rows={8}
              class="contact-summary"
              spellcheck="true"
            >{inquiryOutline}</textarea>
            <div class="copy-row">
              {site.contactEmail && (
                <a
                  id="email-inquiry"
                  data-inquiry-email={site.contactEmail}
                  href={inquiryHref(site.contactEmail, inquiryOutline)}
                  class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
                >
                  Open an email draft <Icon name="diagonal" size={18} />
                </a>
              )}
              <button
                id="copy-inquiry"
                type="button"
                class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
              >
                Copy your outline <Icon size={17} />
              </button>
            </div>
            {site.contactEmail && (
              <>
                <p class="contact-email section-note">
                  Email: {site.contactEmail}
                </p>
                <p class="section-note">
                  Opens your email application. Review and send the message
                  there.
                </p>
                <noscript>
                  <p>
                    To include an edited outline, copy it into a message to the
                    address above.
                  </p>
                </noscript>
              </>
            )}
            <p id="copy-status" class="copy-status" role="status"></p>
            <p class="section-note">
              Nothing is submitted or saved by this website. Refreshing the page
              clears your outline.
            </p>
          </section>
          <div class="article">
            <h2>Licensing questions</h2>
            <p>
              To obtain a commercial entitlement or clarify the scope of an
              intended use,{' '}
              <a href={licensingAction.href}>contact {licence.email}</a>. Read
              the <a href="/pricing/">access and licensing summary</a> and the{' '}
              <a href={licence.href}>full Licence Agreement</a>.
            </p>
            <h2>Product questions & issue reports</h2>
            <p>
              Include your application version, operating system, GPU and
              driver, the steps you took, and the behaviour you expected. Only
              share logs or a minimal example after checking that they contain
              no confidential information.
            </p>
            <h2>Private project support</h2>
            <p>
              Project-specific help and commercial pilots are scoped by
              agreement. A private support and security-reporting route will be
              published before public release.
            </p>
            <p>No public issue tracker is linked during this preview.</p>
          </div>
        </>
      )}
      {page === 'validation' && (
        <>
          <div class="info-panel ambient amb-surface amb-chamfer">
            <h2>Public evidence status</h2>
            <p>
              No approved public demonstration, numerical verification, physical
              validation, or performance records are published here yet. This
              describes the public record, not the existence of internal
              testing.
            </p>
            <p class="section-note">
              Website content reviewed: {site.reviewed}. No public product
              version is attached to these illustrations.
            </p>
          </div>
          <div class="article">
            {evidenceGuide.map((item) => (
              <section>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </section>
            ))}
            <h2>What to inspect in a result record</h2>
            <ul>
              <li>
                The physical question, reference source, and scope of the
                comparison.
              </li>
              <li>
                The application version, solver configuration, and reproducible
                input setup.
              </li>
              <li>
                Geometry, liquid properties, boundary conditions, resolution,
                time steps, and observation interval.
              </li>
              <li>
                Measured quantities, extraction methods, comparison results, and
                uncertainty or known limitations.
              </li>
            </ul>
            <h2>Performance needs its own context.</h2>
            <p>
              A timing record also needs hardware and driver details, the
              workload, and a timing method that states what is included. An
              accelerated recording does not establish physical real-time
              performance.
            </p>
            <h2>Read availability and evidence separately.</h2>
            <p>
              A feature can be implemented while its application remains in
              development. A released build may still lack validation for a
              particular use. Application records label availability as
              released, in development, or planned, and evidence as
              illustration, software demonstration, numerical verification, or
              physical validation.
            </p>
            <a class="text-link" href="/showcases/">
              Explore the application questions <Icon />
            </a>
          </div>
        </>
      )}
      {page === 'pricing' && (
        <>
          <div class="access-grid">
            <article class="platform-card">
              <h2>Free noncommercial use</h2>
              <p>
                Install, run, study, copy, modify, and redistribute the Software
                for lawful noncommercial purposes under the agreement. No
                purchase, subscription, academic affiliation, or separate
                permission is required.
              </p>
              <span class="tag">Royalty-free noncommercial licence</span>
            </article>
            <article class="platform-card">
              <h2>Commercial use</h2>
              <p>
                Purchase a commercial licence or subscription before any
                commercial use. This includes internal business analysis,
                design, training, procurement evaluation, consulting, and work
                on products or services intended for sale.
              </p>
              <span class="tag">Paid entitlement required</span>
            </article>
          </div>
          <div class="article">
            <p>
              Summary of the Prelimina Licence Agreement, version{' '}
              {licence.version}, dated{' '}
              <time datetime={licence.date}>{licence.dateLabel}</time>.{' '}
              <a href={licence.href}>Read the full agreement</a> for the
              complete terms.
            </p>
            <h2>The purpose of the work determines eligibility.</h2>
            <p>
              Noncommercial activity is not directed towards commercial
              advantage or monetary compensation for you or anyone else.
              Personal projects, independent learning, teaching, and research
              can qualify when they do not serve a commercial purpose. Academic
              salaries, tuition, public funding, and research grants do not by
              themselves make an activity commercial.
            </p>
            <p>
              An organisation’s legal form or nonprofit status does not decide
              eligibility. Unpaid work, free delivery, or calling work
              “evaluation” or “research” does not make an otherwise commercial
              activity noncommercial.
            </p>
            <h2>Noncommercial permissions</h2>
            <p>
              The licence imposes no limits on users, installations, computing
              capacity, simulation size, or duration of noncommercial use. When
              sharing the Software or a derivative, include the agreement,
              retain the required notices, and identify modifications. This is a
              noncommercial licence, not an open-source licence granting
              unrestricted commercial use.
            </p>
            <h2>Commercial evaluations and pilots</h2>
            <p>
              Evaluate Prelimina against a real engineering question. Commercial
              pilots are scoped around your application, the required
              capabilities, and the support involved. Commercial evaluation
              requires a paid entitlement before it starts; the ability to run
              without a key does not authorise commercial use.
            </p>
            <p>
              Your accepted order or separate commercial agreement sets the
              permitted activities, covered versions, quantities or capacity,
              term, fees, and purchased services. Hosted access, embedding,
              resale, and commercial redistribution need express coverage. No
              public price or standard commercial package is published here.
            </p>
            <h2>Your data and results</h2>
            <p>
              You retain your rights in inputs, projects, designs, and outputs.
              The agreement gives PLASMICA no permission to publish your data or
              use it to train AI models. Outputs lawfully produced under a
              commercial entitlement may continue to be used and supplied to
              clients after it expires; further commercial simulations require a
              valid entitlement.
            </p>
            <p>
              Using outputs originally created for a noncommercial purpose in
              commercial work requires an entitlement covering that use before
              the commercial use begins.
            </p>
            <h2>Support, services, and responsibility</h2>
            <p>
              The licence alone does not promise source code, updates, support,
              or additional functionality. Product support and project-specific
              engineering services need an agreed scope. Payment alone does not
              promise accuracy, certification, or suitability. You remain
              responsible for independently verifying and validating results;
              express written commitments and mandatory legal rights remain
              applicable.
            </p>
            <p class="notice">
              Prelimina is in development. These permissions apply to Software
              supplied under the agreement; no public installer is available
              here yet.
            </p>
            <a
              href={licensingAction.href}
              class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            >
              {licensingAction.label} <Icon name="diagonal" size={18} />
            </a>
            <p class="contact-email section-note">
              Licensing and legal enquiries: {licence.email}
            </p>
          </div>
        </>
      )}
      {page === 'legal' && (
        <div class="article">
          <h2>About this preview</h2>
          <p>
            Prelimina is developed by {site.company} This preliminary website is
            not a software release or an offer of platform support. Software
            supplied under the Prelimina Licence Agreement is governed by that
            agreement.
          </p>
          <h2>Company and legal contact</h2>
          <p>
            {site.company}
            <br />
            {licence.address}
            <br />
            VAT-ID: {licence.vatId}
          </p>
          <p>
            Licensing and legal enquiries, notices, and complaints:{' '}
            <a href={licensingAction.href}>{licence.email}</a>.
          </p>
          <h2>Privacy in this implementation</h2>
          <p>
            The website contains no analytics, advertising cookies, session
            replay, remote fonts, or third-party embeds. The case-outline
            control does not send data to a server; its copy button only writes
            to your clipboard when you use it.
          </p>
          <p>
            A hosting provider may process network request logs.
            Hosting-specific disclosures and the full public privacy and website
            terms will accompany the public product release.
          </p>
          <h2>Software licence</h2>
          <p>
            The <a href={licence.href}>Prelimina Licence Agreement</a>, version{' '}
            {licence.version} dated{' '}
            <time datetime={licence.date}>{licence.dateLabel}</time>, grants
            free noncommercial use and requires a paid entitlement before
            commercial use. The{' '}
            <a href="/pricing/">access and licensing summary</a> explains these
            permissions; the full agreement governs.
          </p>
          <p>
            The agreement retains your rights in your data and results, requires
            independent verification, and sets warranty and liability provisions
            with mandatory legal exceptions. An accepted commercial order or
            separate agreement defines any additional commercial scope and
            services. A later website notice does not retroactively change
            rights granted for a supplied version.
          </p>
          <h2>Third-party design assets</h2>
          <p>
            The site uses AmbientCSS under the MIT license and the locally
            hosted Bacasime Antique font under the SIL Open Font License 1.1.
          </p>
          <div class="legal-list">
            <a href="/licenses/AmbientCSS-MIT.txt">AmbientCSS license</a>
            <a href="/licenses/BacasimeAntique-OFL.txt">
              Bacasime Antique license
            </a>
          </div>
        </div>
      )}
      {page === 'changelog' && (
        <div class="info-panel ambient amb-surface amb-chamfer">
          <h2>Prelaunch</h2>
          <p>
            No public product version or installer is attached to this design
            preview.
          </p>
          <a class="text-link" href="/download/">
            Check download availability <Icon />
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
<script>
  import { inquiryHref } from '../content/inquiry.mjs';
  const emailLink = document.querySelector<HTMLAnchorElement>('#email-inquiry');
  const outline = document.querySelector<HTMLTextAreaElement>('#inquiry');
  const updateDraft = () => {
    const address = emailLink?.dataset.inquiryEmail;
    if (emailLink && address && outline)
      emailLink.href = inquiryHref(address, outline.value);
  };
  outline?.addEventListener('input', updateDraft);
  emailLink?.addEventListener('click', updateDraft);
  const copy = document.querySelector<HTMLButtonElement>('#copy-inquiry');
  copy?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (!outline || !status) return;
    try {
      await navigator.clipboard.writeText(outline.value);
      status.textContent = 'Outline copied. Nothing has been sent.';
    } catch {
      outline.focus();
      outline.select();
      status.textContent =
        'Clipboard access is unavailable. Your outline is selected; copy it with your usual keyboard command.';
    }
  });
</script>
