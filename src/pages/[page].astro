---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import CapabilityCatalog from '../components/CapabilityCatalog.astro';
import SolverSection from '../components/SolverSection.astro';
import ReleaseHistory from '../components/ReleaseHistory.astro';
import { loadCatalogue } from '../data/releases.mjs';
import site from '../content/site.json';
import { pages } from '../content/pages';
import {
  licence,
  licensingAction,
  showcases,
} from '../content/content';
export function getStaticPaths() {
  return Object.entries(pages).map(([page, content]) => ({
    params: { page },
    props: { content },
  }));
}
const { content } = Astro.props;
const { page } = Astro.params;
const { current } = loadCatalogue();
const title = page === 'changelog' && current ? 'Release history.' : content.title;
const description = page === 'changelog' && current ? 'Approved notes for published desktop releases.' : content.description;
---

<Layout title={title} description={description}>
  <div class="container">
    {page === 'capabilities' && <SolverSection />}
    <header
      class={
        page === 'capabilities' ? 'page-hero capabilities-page-hero' : 'page-hero'
      }
    >
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="page-container">
      {page === 'showcases' && (
        <>
          <div class="showcase-grid">
            {showcases.map((item) => (
              <ShowcaseCard item={item} />
            ))}
          </div>
        </>
      )}
      {page === 'capabilities' && <CapabilityCatalog />}
      {page === 'legal' && (
        <div class="article">
          <h2>About this preview</h2>
          <p>
            Prelimina is developed by {site.company} This preliminary website is
            not a software release or an offer of platform support. Software
            supplied under the Prelimina Licence Agreement is governed by that
            agreement.
          </p>
          <h2>Company and legal contact</h2>
          <p>
            {site.company}
            <br />
            {licence.address}
            <br />
            VAT-ID: {licence.vatId}
          </p>
          <p>
            Licensing and legal enquiries, notices, and complaints:{' '}
            <a href={licensingAction.href}>{licence.email}</a>.
          </p>
          <h2 id="privacy">Privacy in this implementation</h2>
          <p>
            The website contains no analytics, advertising cookies, session
            replay, remote fonts, or third-party embeds. The case-outline
            control does not send data to a server; its copy button only writes
            to your clipboard when you use it.
          </p>
          <p>
            If you subscribe to release updates, the email address you enter is
            sent to Brevo (Sendinblue SAS, France), which stores it with the
            time of your consent and sends you a confirmation email. You are
            only added once you confirm. We use the address solely to tell you
            about Prelimina releases and the browser version. Every email has an
            unsubscribe link, and you can ask us to delete your address at any
            time{site.contactEmail && (
              <>
                {' '}at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
              </>
            )}.
          </p>
          <p>
            A hosting provider may process network request logs.
            Hosting-specific disclosures and the full public privacy and website
            terms will accompany the public product release.
          </p>
          <h2>Software licence</h2>
          <p>
            The <a href={licence.href}>Prelimina Licence Agreement</a>, version{' '}
            {licence.version} dated{' '}
            <time datetime={licence.date}>{licence.dateLabel}</time>, grants
            free noncommercial use and requires a paid entitlement before
            commercial use. The <a href="/#faq">FAQ</a> explains
            these permissions; the full agreement governs.
          </p>
          <p>
            The agreement retains your rights in your data and results, requires
            independent verification, and sets warranty and liability provisions
            with mandatory legal exceptions. An accepted commercial order or
            separate agreement defines any additional commercial scope and
            services. A later website notice does not retroactively change
            rights granted for a supplied version.
          </p>
          <h2>Third-party design assets</h2>
          <p>
            The site uses AmbientCSS under the MIT license and the locally
            hosted Fraunces and Quicksand fonts under the SIL Open Font License
            1.1.
          </p>
          <div class="legal-list">
            <a href="/licenses/AmbientCSS-MIT.txt">AmbientCSS license</a>
            <a href="/licenses/Fraunces-OFL.txt">Fraunces license</a>
            <a href="/licenses/Quicksand-OFL.txt">Quicksand license</a>
          </div>
        </div>
      )}
      {page === 'confirmed' && (
        <a class="text-link" href="/">
          Back to the homepage <Icon />
        </a>
      )}
      {page === 'changelog' && current && <ReleaseHistory />}
      {page === 'changelog' && !current && (
        <div class="info-panel">
          <h2>Prelaunch</h2>
          <p>
            No public product version or installer is attached to this design
            preview.
          </p>
          <a class="text-link" href="/#download">
            Check download availability <Icon />
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
