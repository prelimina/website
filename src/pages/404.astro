---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found">
  <div class="container page-container">
    <header class="page-hero">
      <p class="case-label">404</p>
      <h1>Let’s find the flow again.</h1>
      <p>This page doesn’t exist. The homepage is a good place to start.</p>
    </header>
    <a
      class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      href="/"
    >
      Back to Prelimina <Icon />
    </a>
  </div>
</Layout>
