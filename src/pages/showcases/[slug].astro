---
import Layout from '../../layouts/Layout.astro';
import ShowcaseMedia from '../../components/ShowcaseMedia.astro';
import Icon from '../../components/Icon.astro';
import {
  inquiryAction,
  showcases,
  availabilityLabels,
} from '../../content/content';
export function getStaticPaths() {
  return showcases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
const action = inquiryAction.open ? inquiryAction.primary : item.nextAction;
---

<Layout title={item.title} description={item.description}>
  <div class="container">
    <header class="page-hero">
      <a href="/showcases/" class="back-link">
        <Icon size={15} /> All applications
      </a>
      <div class="case-label">
        Application / {item.number} · {item.category}
      </div>
      <h1>{item.title}</h1>
      <p>{item.question}</p>
      <p class="application-status">
        <span>Availability: {availabilityLabels[item.availability]}</span>
      </p>
    </header>
    <div class="page-container">
      <div class="case-layout">
        <dl>
          <dt>Inputs</dt>
          <dd>{item.inputs}</dd>
          <dt>Variables to explore</dt>
          <dd>{item.variables}</dd>
          <dt>Keep the comparison consistent</dt>
          <dd>{item.controls}</dd>
          <dt>Outputs</dt>
          <dd>{item.outputs}</dd>
          <dt>{item.metricsHeading ?? 'Comparison quantities'}</dt>
          <dd>{item.metrics}</dd>
          <dt>Physical assumptions</dt>
          <dd>{item.assumptions}</dd>
          <dt>Scope</dt>
          <dd>{item.limitation}</dd>
        </dl>
        <div>
          <div class="showcase-visual">
            <div class="showcase-meta">
              <span>APPLICATION / {item.number}</span>
              <span>{item.media ? 'Simulation' : 'Illustration'}</span>
            </div>
            <ShowcaseMedia illustration={item.type} media={item.media} />
            {item.chart && (
              <ShowcaseMedia illustration={item.type} media={item.chart} />
            )}
            {!item.media && (
              <span class="study-stamp">
                Illustration — not simulation results
              </span>
            )}
          </div>
        </div>
      </div>
      <a
        href={action.href}
        class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      >
        {action.label} <Icon name="diagonal" size={18} />
      </a>
    </div>
  </div>
</Layout>
