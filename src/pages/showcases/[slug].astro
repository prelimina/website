---
import Layout from '../../layouts/Layout.astro';
import ShowcaseMedia from '../../components/ShowcaseMedia.astro';
import Icon from '../../components/Icon.astro';
import {
  inquiryAction,
  showcases,
  availabilityLabels,
  evidenceLabels,
} from '../../content/content';
export function getStaticPaths() {
  return showcases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
const action = inquiryAction.open ? inquiryAction.primary : item.nextAction;
---

<Layout title={item.title} description={item.description}>
  <div class="container">
    <header class="page-hero">
      <a href="/showcases/" class="back-link">
        <Icon size={15} /> All applications
      </a>
      <div class="case-label">
        Candidate application / {item.number} · {item.category}
      </div>
      <h1>{item.title}</h1>
      <p>{item.question}</p>
      <p class="application-status">
        <span>Availability: {availabilityLabels[item.availability]}</span>
        <span>Evidence: {evidenceLabels[item.evidence]}</span>
      </p>
    </header>
    <div class="page-container">
      <div class="case-layout">
        <dl>
          <dt>Inputs</dt>
          <dd>{item.inputs}</dd>
          <dt>Variables to explore</dt>
          <dd>{item.variables}</dd>
          <dt>Keep the comparison consistent</dt>
          <dd>{item.controls}</dd>
          <dt>Outputs in the development application</dt>
          <dd>{item.outputs}</dd>
          <dt>
            {item.evidence === 'physical_validation'
              ? 'Comparison with measurements'
              : 'Candidate comparison quantities'}
          </dt>
          <dd>{item.metrics}</dd>
          <dt>Physical assumptions</dt>
          <dd>{item.assumptions}</dd>
          <dt>Numerical limitations and evidence scope</dt>
          <dd>{item.limitation}</dd>
        </dl>
        <div>
          <div class="showcase-visual">
            <div class="showcase-meta">
              <span>APPLICATION / {item.number}</span>
              <span>{item.media ? evidenceLabels[item.evidence] : 'Illustration'}</span>
            </div>
            <ShowcaseMedia illustration={item.type} media={item.media} />
            {item.chart && (
              <ShowcaseMedia illustration={item.type} media={item.chart} />
            )}
            {!item.media && (
              <span class="study-stamp">
                Illustration — not simulation results
              </span>
            )}
          </div>
          <p class="section-note">
            {!item.media
              ? 'No public release, reproducible result set, or hardware qualification is attached to this candidate application.'
              : item.evidence === 'physical_validation'
                ? 'Computed with a development build and compared with published measurements. The agreement holds for this case only.'
                : 'Recorded from a development build. It shows the workflow, not a validated result.'}
          </p>
        </div>
      </div>
      <p class="notice">
        Use this question to frame a study. Establish the method, measurements,
        and evidence needed for your decision before relying on a result.
      </p>
      <a
        href={action.href}
        class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      >
        {action.label} <Icon name="diagonal" size={18} />
      </a>
    </div>
  </div>
</Layout>
