---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { chapters, guidePdf } from '../../data/guide';
---

<Layout
  title="User Guide"
  description="Learn Prelimina from your first simulation onwards. Read the guide online or download it as a PDF."
>
  <div class="container guide-layout">
    <aside class="guide-sidebar">
      <nav aria-label="Guide contents">
        <ol class="guide-contents">
          {chapters.map((chapter) => (
            <li>
              <a class="guide-contents-chapter" href={`#${chapter.slug}`}>
                {chapter.number}. {chapter.title}
              </a>
              <ul>
                {chapter.headings.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <a class="guide-sidebar-pdf" href={guidePdf.href} download>
          <Icon name="download" size={16} /> Download PDF
        </a>
      </nav>
    </aside>
    <article class="guide-article">
      <header>
        <p class="guide-kicker">Prelimina {guidePdf.version} · Updated {guidePdf.updatedLabel}</p>
        <h1>User Guide</h1>
        <p>Learn Prelimina from your first simulation onwards.</p>
      </header>
      {chapters.map((chapter) => (
        <section class="guide-chapter" id={chapter.slug}>
          <p class="guide-kicker">Chapter {chapter.number}</p>
          <h2>{chapter.title}</h2>
          <Fragment set:html={chapter.html} />
        </section>
      ))}
    </article>
  </div>
  <script>
    // Marks the section being read and opens its chapter in the contents.
    const contents = document.querySelector<HTMLElement>('.guide-contents');
    const links = [...(contents?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    const targets = links.flatMap((link) => {
      const target = document.getElementById(link.hash.slice(1));
      return target ? [{ link, target }] : [];
    });
    let scheduled = false;
    const mark = () => {
      scheduled = false;
      const line = window.innerHeight * 0.3;
      let current = targets[0];
      for (const item of targets) {
        if (item.target.getBoundingClientRect().top > line) break;
        current = item;
      }
      if (!current) return;
      contents?.classList.add('is-tracking');
      links.forEach((link) => link.removeAttribute('aria-current'));
      current.link.setAttribute('aria-current', 'location');
      contents?.querySelector('.is-active')?.classList.remove('is-active');
      current.link.closest('.guide-contents > li')?.classList.add('is-active');
      const panel = contents?.parentElement;
      if (panel && panel.scrollHeight > panel.clientHeight) {
        const top = current.link.offsetTop - panel.offsetTop;
        if (top < panel.scrollTop || top > panel.scrollTop + panel.clientHeight - 80)
          panel.scrollTop = top - panel.clientHeight / 3;
      }
    };
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(mark);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    mark();
  </script>
</Layout>
