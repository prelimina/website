---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { chapters, guidePdf } from '../../data/guide';

export async function getStaticPaths() {
  return chapters.map((chapter, index) => ({
    params: { chapter: chapter.slug },
    props: {
      chapter,
      previous: chapters[index - 1],
      next: chapters[index + 1],
    },
  }));
}
const { chapter, previous, next } = Astro.props;
---

<Layout title={chapter.title} description={chapter.summary}>
  <div class="container guide-layout">
    <aside class="guide-sidebar">
      <nav aria-label="This chapter">
        <a class="guide-back" href="/guide/">User Guide</a>
        <ul>
          {chapter.headings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
        <a class="guide-sidebar-pdf" href={guidePdf.href} download>
          <Icon name="download" size={16} /> Download PDF
        </a>
      </nav>
    </aside>
    <article class="guide-article">
      <header>
        <p class="guide-kicker">
          Chapter {chapter.number} · Prelimina {guidePdf.version}
        </p>
        <h1>{chapter.title}</h1>
      </header>
      <Fragment set:html={chapter.html} />
      {(previous || next) && (
        <nav class="guide-pager" aria-label="Chapters">
          {previous && <a href={`/guide/${previous.slug}/`}>← {previous.title}</a>}
          {next && <a href={`/guide/${next.slug}/`}>{next.title} →</a>}
        </nav>
      )}
    </article>
  </div>
</Layout>
