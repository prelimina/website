---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import DownloadSection from '../components/DownloadSection.astro';
import CapabilitySummary from '../components/CapabilitySummary.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import { loadCatalogue } from '../data/releases.mjs';
import site from '../content/site.json';
import {
  createProductAction,
  showcases,
  faqs,
  licence,
  licensingAction,
} from '../content/content';
const productAction = createProductAction(loadCatalogue().current);
---

<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <h1>
        See the flow.
        <br />
        Shape the <em>design.</em>
      </h1>
      <p class="hero-descriptor">{site.hero.descriptor}</p>
      <p class="hero-description">{site.hero.description}</p>
      <div class="hero-actions">
        <a
          href={productAction.href}
          class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2 amb-elevation-0"
        >
          {productAction.label} <Icon name="diagonal" size={18} />
        </a>
        <a
          href="#applications"
          class="button button-quiet ambient amb-surface-convex amb-mat-matte amb-fillet-2"
        >
          Explore applications <Icon size={18} />
        </a>
      </div>
    </div>
    <div class="hero-object">
      <Workbench />
    </div>
  </section>
  <section class="section showcase-section" id="applications">
    <div class="container">
      <div class="section-heading">
        <h2>
          Start with an <em>engineering question.</em>
        </h2>
      </div>
      <div class="showcase-grid">
        {showcases.map((item) => (
          <ShowcaseCard item={item} />
        ))}
      </div>
      <div class="section-action">
        <a
          class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
          href="/showcases/"
        >
          Explore all applications <Icon size={18} />
        </a>
        <p>Review each application’s question, inputs, and scope.</p>
      </div>
    </div>
  </section>
  <AppScreenshot />
  <CapabilitySummary />
  <DownloadSection />
  <section class="section container faq-section" id="faq">
    <div class="faq-intro" id="licensing">
      <h2>FAQ</h2>
      <p>Answers about Prelimina, getting started, and licensing.</p>
      <a class="text-link" href={licence.href}>
        Read the full agreement <Icon size={16} />
      </a>
      <a class="text-link" href={licensingAction.href}>
        {licensingAction.label} <Icon size={16} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>
            {item.question}
            <Icon name="plus" size={18} />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="container cta-wrap">
    <div class="cta-panel">
      <div>
        <h2>
          What would you <em>change next?</em>
        </h2>
        <p>
          {productAction.available
            ? 'Review the current desktop release and platform requirements.'
            : 'Check release status and platform availability for the desktop app.'}
        </p>
      </div>
      <a
        href={productAction.href}
        class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2 amb-elevation-0"
      >
        {productAction.label} <Icon name="diagonal" size={18} />
      </a>
    </div>
  </section>
</Layout>
