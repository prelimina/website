---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import DownloadSection from '../components/DownloadSection.astro';
import site from '../content/site.json';
import {
  access,
  workflow,
  iteration,
  showcases,
  faqs,
} from '../content/content';
---

<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <h1>
        See the flow.
        <br />
        Shape the <em>design.</em>
      </h1>
      <p class="hero-descriptor">{site.hero.descriptor}</p>
      <p class="hero-description">{site.hero.description}</p>
      <div class="hero-actions">
        <a
          href={access.primary.href}
          class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2 amb-elevation-0"
        >
          {access.primary.label} <Icon name="diagonal" size={18} />
        </a>
        <a
          href="#workflow"
          class="button button-quiet ambient amb-surface-convex amb-mat-matte amb-fillet-2"
        >
          See the workflow <Icon size={18} />
        </a>
      </div>
      <p class="hero-note">
        <span class="small-status"></span> {access.status}
      </p>
    </div>
    <div class="hero-object">
      <Workbench />
    </div>
  </section>
  <section class="section showcase-section" id="applications">
    <div class="container">
      <div class="section-heading">
        <h2>
          Start with an <em>engineering question.</em>
        </h2>
        <a href="/showcases/" class="text-link">
          Explore all applications <Icon />
        </a>
      </div>
      <div class="showcase-grid">
        {showcases.map((item) => (
          <ShowcaseCard item={item} />
        ))}
      </div>
      <p class="section-note">
        Initial application focus. These candidates use illustrations; they are
        not released applications or simulation results.
      </p>
    </div>
  </section>
  <section class="section container" id="workflow">
    <div class="section-heading">
      <h2>
        From the experiment
        <br />
        to <em>the next iteration.</em>
      </h2>
      <p>
        Three stages in the desktop application, currently in development.
        Understand how your liquid moves, then use that insight to improve the
        design.
      </p>
    </div>
    <div class="workflow-rail ambient amb-surface amb-chamfer">
      <ol>
        {workflow.map((step, index) => (
          <li>
            <span class="workflow-number ambient amb-surface amb-chamfer amb-elevation-0">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>
              <strong>{step.detail}</strong> {step.text}
            </p>
            {index < workflow.length - 1 && (
              <span class="workflow-arrow" aria-hidden="true">
                <Icon />
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
    <p class="section-note">
      <strong>{iteration.title}</strong> {iteration.text}
    </p>
    <p class="section-note">
      Geometry, motion, measurements, and exports depend on the selected method.{' '}
      <a class="text-link" href="/docs/">
        Review the workflow and its limits <Icon size={16} />
      </a>
    </p>
  </section>
  <section class="section product-section" id="product">
    <div class="container">
      <div class="section-heading">
        <h2>
          A place beside
          <br />
          <em>your existing tools.</em>
        </h2>
        <p>
          For small engineering teams, equipment designers, consultants,
          laboratories, and educators working toward the next design decision.
        </p>
      </div>
      <div class="benefit-grid">
        <article>
          <div class="icon-tile ambient amb-surface amb-chamfer amb-elevation-0">
            <Icon name="layers" size={25} />
          </div>
          <h3>Add fluid insight to your CAD.</h3>
          <p>
            Create and revise geometry in the tools you know. Bring supported
            mesh geometry into Prelimina for simulation, then take your findings
            back to the next design revision.
          </p>
        </article>
        <article>
          <div class="icon-tile ambient amb-surface amb-chamfer amb-elevation-0">
            <Icon name="chip" size={25} />
          </div>
          <h3>Use the GPU on your desktop.</h3>
          <p>
            Prelimina is built around GPU-native simulation. It's faster than
            the fastest competitors.
          </p>
        </article>
        <article>
          <div class="icon-tile ambient amb-surface amb-chamfer amb-elevation-0">
            <Icon name="diagonal" size={25} />
          </div>
          <h3>Inspect more than a picture.</h3>
          <p>
            The development application includes live diagnostics, pressure and
            velocity probes, CSV measurements, and simulation-field exports.
            Availability depends on the method; qualify measurements for the
            decision they will support.
          </p>
        </article>
      </div>
      <p class="section-note">
        Moving liquids are the initial focus. Broader CFD applications remain a
        development direction, with their own implementation and evidence
        requirements.
      </p>
    </div>
  </section>
  <DownloadSection />
  <section class="section container faq-section" id="faq">
    <h2>
      Before you <em>begin.</em>
    </h2>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>
            {item.question}
            <Icon name="plus" size={18} />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="container cta-wrap">
    <div class="cta-panel ambient amb-surface amb-chamfer-2 amb-elevation-0">
      <div>
        <h2>
          What would you <em>change next?</em>
        </h2>
        <p>
          {access.open
            ? 'Start with your design question, the comparison you need, and the decision it would inform.'
            : 'Explore the initial applications and the questions each one could help investigate.'}
        </p>
      </div>
      <a
        href={access.primary.href}
        class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2 amb-elevation-0"
      >
        {access.primary.label} <Icon name="diagonal" size={18} />
      </a>
    </div>
  </section>
</Layout>
