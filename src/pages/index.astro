---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import DownloadSection from '../components/DownloadSection.astro';
import CapabilitySummary from '../components/CapabilitySummary.astro';
import TeamSection from '../components/TeamSection.astro';
import FlowBackdrop from '../components/FlowBackdrop.astro';
import SignupPanel from '../components/SignupPanel.astro';
import AppScreenshot from '../components/AppScreenshot.astro';
import { loadCatalogue } from '../data/releases.mjs';
import site from '../content/site.json';
import {
  createProductAction,
  showcases,
  faqs,
  licence,
  licensingAction,
} from '../content/content';
const productAction = createProductAction(loadCatalogue().current);
---

<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <h1>
        See the flow.
        <br />
        Shape the <em>design.</em>
      </h1>
      <p class="hero-descriptor">{site.hero.descriptor}</p>
      <p class="hero-description">{site.hero.description}</p>
      <div class="hero-actions">
        <a
          href={productAction.href}
          class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2 amb-elevation-0"
        >
          {productAction.label} <Icon name="diagonal" size={18} />
        </a>
      </div>
    </div>
    <div class="hero-object">
      <Workbench />
    </div>
  </section>
  <section class="section showcase-section band" id="applications">
    <FlowBackdrop seed={0} />
    <div class="container">
      <div class="section-heading">
        <h2>
          <em>Applications.</em>
        </h2>
        <p>
          Validation cases and demonstrations, from tank sloshing to wetting in
          microgravity.
        </p>
      </div>
      <div class="showcase-grid">
        {showcases.map((item) => (
          <ShowcaseCard item={item} />
        ))}
      </div>
    </div>
  </section>
  <AppScreenshot />
  <CapabilitySummary />
  <TeamSection />
  <DownloadSection />
  <section class="section container faq-section" id="faq">
    <div class="faq-intro" id="licensing">
      <h2>FAQ</h2>
      <p>Licensing, supported hardware, and what Prelimina is for.</p>
      <a class="text-link" href={licence.href}>
        Read the full agreement <Icon size={16} />
      </a>
      <a class="text-link" href={licensingAction.href}>
        {licensingAction.label} <Icon size={16} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>
            {item.question}
            <Icon name="plus" size={18} />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <SignupPanel />
</Layout>
