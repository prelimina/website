---
interface Props {
  name?: string;
  size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  diagonal: 'M6 18 18 6M6 6h12v12',
  chip: 'M7 7h10v10H7zM10 10h4v4h-4zM8 3v4m8-4v4M8 17v4m8-4v4M3 8h4m-4 8h4M17 8h4m-4 8h4',
  layers: 'm3 8 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 18l9 5 9-5',
  desktop: 'M3 4h18v13H3zM8 21h8m-4-4v4',
  plus: 'M5 12h14M12 5v14',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  check: 'm5 12 4 4L19 6',
  book: 'M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
