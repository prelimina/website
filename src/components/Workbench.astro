---
import { workflowIllustration } from '../content/content';
---

<div class="workbench" data-workbench>
  <div
    class="bench-screen"
    id="workflow-visual"
    data-stage={workflowIllustration[0].id}
  >
    <div class="screen-top">
      <span class="workflow-label" data-workflow-label>
        {workflowIllustration[0].illustration}
      </span>
      <span data-study-label>01 / {workflowIllustration[0].title}</span>
    </div>
    <div class="bench-media">
      {workflowIllustration.map((step, index) => (
        <picture class="bench-frame" data-frame={step.id}>
          <source
            media="(prefers-reduced-motion: reduce)"
            srcset={step.media.still}
          />
          <img
            src={step.media.src}
            alt={step.media.alt}
            width="960"
            height="580"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </picture>
      ))}
    </div>
  </div>
  <div class="bench-controls" role="group" aria-label="Select a workflow stage">
    {workflowIllustration.map((step, index) => (
      <button
        class="bench-key"
        type="button"
        data-step-button={index}
        aria-pressed={index === 0}
        aria-controls="workflow-visual"
      >
        <span class="key-number">0{index + 1}</span>
        {step.title}
      </button>
    ))}
  </div>
</div>
<script>
  import { workflowIllustration } from '../content/content';
  const workbench = document.querySelector<HTMLElement>('[data-workbench]');
  let activeIndex = 0;
  let autoplayTimer: number | undefined;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const select = (index: number) => {
    if (!workbench) return;
    activeIndex =
      (index + workflowIllustration.length) % workflowIllustration.length;
    workbench
      .querySelectorAll<HTMLButtonElement>('[data-step-button]')
      .forEach((key) =>
        key.setAttribute(
          'aria-pressed',
          String(Number(key.dataset.stepButton) === activeIndex),
        ),
      );
    const screen = workbench.querySelector<HTMLElement>('.bench-screen');
    const description = workbench.querySelector('[data-workflow-label]');
    const label = workbench.querySelector('[data-study-label]');
    if (screen) screen.dataset.stage = workflowIllustration[activeIndex].id;
    if (description)
      description.textContent = workflowIllustration[activeIndex].illustration;
    if (label) {
      label.textContent = `0${activeIndex + 1} / ${workflowIllustration[activeIndex].title}`;
    }
  };

  const stopAutoplay = () => {
    if (autoplayTimer !== undefined) {
      window.clearInterval(autoplayTimer);
      autoplayTimer = undefined;
    }
  };
  const startAutoplay = () => {
    if (
      !workbench ||
      autoplayTimer !== undefined ||
      reducedMotion.matches ||
      document.hidden ||
      workbench.matches(':hover') ||
      workbench.contains(document.activeElement)
    ) {
      return;
    }
    autoplayTimer = window.setInterval(
      () => select((activeIndex + 1) % workflowIllustration.length),
      2000,
    );
  };

  workbench
    ?.querySelectorAll<HTMLButtonElement>('[data-step-button]')
    .forEach((button) =>
      button.addEventListener('click', () =>
        select(Number(button.dataset.stepButton)),
      ),
    );
  workbench?.addEventListener('pointerenter', stopAutoplay);
  workbench?.addEventListener('pointerleave', startAutoplay);
  workbench?.addEventListener('focusin', stopAutoplay);
  workbench?.addEventListener('focusout', (event) => {
    const nextTarget = event.relatedTarget;
    if (nextTarget instanceof Node && workbench?.contains(nextTarget)) return;
    startAutoplay();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopAutoplay();
    else startAutoplay();
  });
  reducedMotion.addEventListener('change', (event) => {
    if (event.matches) stopAutoplay();
    else startAutoplay();
  });
  startAutoplay();
</script>
