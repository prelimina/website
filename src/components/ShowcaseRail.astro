---
import Icon from './Icon.astro';
import ShowcaseCard from './ShowcaseCard.astro';
import { showcases } from '../content/content';
---

<div class="showcase-rail" data-showcase-rail>
  <div
    class="showcase-track"
    role="region"
    aria-label="Applications"
    tabindex="0"
    data-showcase-track
  >
    {showcases.map((item) => (
      <ShowcaseCard item={item} />
    ))}
  </div>
  <div class="showcase-controls">
    <a class="text-link" href="/showcases/">
      All {showcases.length} applications <Icon size={16} />
    </a>
    <div class="showcase-arrows">
      <button
        class="showcase-arrow"
        type="button"
        aria-label="Previous applications"
        data-showcase-prev
        disabled
      >
        <span class="showcase-arrow-back"><Icon size={18} /></span>
      </button>
      <button
        class="showcase-arrow"
        type="button"
        aria-label="Next applications"
        data-showcase-next
      >
        <Icon size={18} />
      </button>
    </div>
  </div>
</div>
<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document
    .querySelectorAll<HTMLElement>('[data-showcase-rail]')
    .forEach((rail) => {
      const track = rail.querySelector<HTMLElement>('[data-showcase-track]');
      const prev = rail.querySelector<HTMLButtonElement>('[data-showcase-prev]');
      const next = rail.querySelector<HTMLButtonElement>('[data-showcase-next]');
      if (!track || !prev || !next) return;

      // One step = one card plus the gap, so every click lands on a snap point.
      const step = () => {
        const card = track.firstElementChild as HTMLElement | null;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return card ? card.offsetWidth + gap : track.clientWidth;
      };
      // Where a smooth scroll is heading, so quick repeat clicks keep stepping.
      let target: number | undefined;
      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        if (target !== undefined && Math.abs(track.scrollLeft - target) < 2) {
          target = undefined;
        }
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
      };
      const move = (direction: number) => {
        const size = step();
        const max = track.scrollWidth - track.clientWidth;
        const from = target ?? track.scrollLeft;
        target = Math.min(
          max,
          Math.max(0, (Math.round(from / size) + direction) * size),
        );
        track.scrollTo({
          left: target,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };

      prev.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();

      // Autoplay: step one card at a time while the rail is on screen and the
      // reader is not hovering, focused in it, or recently touching it.
      const autoplayDelay = 4000;
      const idleAfterInteraction = 8000;
      let lastInteraction = 0;
      let inView = false;
      const interact = () => {
        lastInteraction = Date.now();
      };
      ['pointerdown', 'wheel', 'keydown'].forEach((type) =>
        rail.addEventListener(type, interact, { passive: true }),
      );
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
        },
        { threshold: 0.5 },
      ).observe(track);
      window.setInterval(() => {
        if (
          !inView ||
          reducedMotion.matches ||
          document.hidden ||
          rail.matches(':hover') ||
          rail.contains(document.activeElement) ||
          Date.now() - lastInteraction < idleAfterInteraction
        ) {
          return;
        }
        if (next.disabled) {
          target = 0;
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          move(1);
        }
      }, autoplayDelay);
    });
</script>
