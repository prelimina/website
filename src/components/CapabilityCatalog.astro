---
import Icon from './Icon.astro';
import { capabilityGroups, maturity } from '../content/capabilities';
import { productActionConfig } from '../content/content';
---

<div class="capability-catalog">
  {capabilityGroups.map((group) => (
    <section
      class="capability-group"
      id={group.id}
      aria-labelledby={`${group.id}-title`}
    >
      <div class="capability-group-heading">
        <span class="capability-icon ambient amb-mat-glass">
          <Icon name={group.icon} size={26} />
        </span>
        <h2 id={`${group.id}-title`}>{group.title}</h2>
      </div>
      <p class="capability-group-description">{group.description}</p>
      <ul class="capability-feature-list">
        {group.features.map((feature) => (
          <li>
            <div class="capability-feature-heading">
              <h3>{feature.name}</h3>
              <span class="maturity-badge" data-maturity={feature.status}>
                {maturity[feature.status].label}
              </span>
            </div>
            <p>{feature.description}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
<div class="capabilities-overview">
  <h2>What the labels mean</h2>
  <p>
    Maturity describes the current development build. Solver-specific scope is
    noted with each feature.
  </p>
  <dl class="maturity-guide">
    {Object.entries(maturity).map(([status, item]) => (
      <div>
        <dt>
          <span class="maturity-badge" data-maturity={status}>
            {item.label}
          </span>
        </dt>
        <dd>{item.description}</dd>
      </div>
    ))}
  </dl>
</div>
<aside
  class="capabilities-download info-panel"
  aria-labelledby="capabilities-download-title"
>
  <span class="capability-icon ambient amb-mat-glass">
    <Icon name="download" size={26} />
  </span>
  <div class="capabilities-download-copy">
    <h2 id="capabilities-download-title">
      Try it on your <em>own geometry.</em>
    </h2>
    <p>
      Download the desktop app for Windows or Linux. Free for noncommercial
      use; commercial licences available.
    </p>
  </div>
  <div class="capabilities-download-actions">
    <a
      class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      href={productActionConfig.href}
    >
      {productActionConfig.label} <Icon name="download" size={18} />
    </a>
    <a class="text-link" href="/showcases/">
      Explore applications <Icon size={16} />
    </a>
  </div>
</aside>
