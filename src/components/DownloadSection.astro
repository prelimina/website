---
import Icon from './Icon.astro';
import FlowBackdrop from './FlowBackdrop.astro';
import site from '../content/site.json';
import { downloadPlatforms } from '../content/content';
import { loadCatalogue } from '../data/releases.mjs';
const { current } = loadCatalogue();
const version = current?.version ?? site.downloadPreview.version;
const date = current?.publishedAt.slice(0, 10) ?? site.downloadPreview.date;
const downloadUrl = (platform: string) => current?.downloads.find((d: { channel: string; installerUrl: string }) =>
  d.channel === (platform === 'windows' ? 'win-x64' : 'linux-x64'))?.installerUrl ?? site.downloadPreview.releasesUrl;
const releaseDateLabel = new Date(date).toLocaleDateString(
  'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
---

<section class="section container download-section band" id="download">
  <FlowBackdrop seed={2} />
  <div class="section-heading">
    <div>
      <h2>
        <em>Download.</em>
      </h2>
      <p class="download-intro">
        Free for noncommercial use. Windows and Linux now, macOS and a browser version later.
      </p>
    </div>
  </div>
  <div class="release-summary">
    <dl>
      <div>
        <dt>Current version</dt>
        <dd>v{version}</dd>
      </div>
      <div>
        <dt>Release date</dt>
        <dd>
          <time datetime={date}>{releaseDateLabel}</time>
        </dd>
      </div>
      <div>
        <dt>Changes</dt>
        <dd>
          <a class="text-link" href="/changelog/">
            Changelog <Icon size={16} />
          </a>
        </dd>
      </div>
    </dl>
  </div>
  <div class="platform-grid">
    {downloadPlatforms.map((platform) => (
      <article class="platform-card">
        <div class="platform-heading">
          <span class="capability-icon platform-icon ambient amb-mat-glass">
            <Icon name={platform.icon} size={32} />
          </span>
          <div>
            <h3>{platform.name}</h3>
          </div>
        </div>
        <dl class="platform-requirements">
          {platform.requirements.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {platform.id === 'macos' ? (
          <button
            type="button"
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            disabled
          >
            <Icon name="download" size={18} /> Coming soon
          </button>
        ) : (
          <a
            href={downloadUrl(platform.id)}
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
          >
            <Icon name="download" size={18} /> Download for {platform.name}
          </a>
        )}
      </article>
    ))}
  </div>
</section>
