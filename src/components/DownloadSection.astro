---
import Icon from './Icon.astro';
import site from '../content/site.json';
import {
  downloadPlatforms,
  licence,
  licensingAction,
  licensingFaqs,
} from '../content/content';
const releaseDateLabel = new Date(site.downloadPreview.date).toLocaleDateString(
  'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
---

<section class="section container download-section" id="download">
  <div class="section-heading">
    <div>
      <h2>
        Download <em>Prelimina.</em>
      </h2>
      <p class="download-intro">Free for noncommercial use. Commercial licences available.</p>
    </div>
  </div>
  <div class="release-summary ambient amb-surface amb-chamfer-concave amb-fillet">
    <dl>
      <div>
        <dt>Current version</dt>
        <dd>
          v{site.downloadPreview.version} <span>Release preview</span>
        </dd>
      </div>
      <div>
        <dt>Release date</dt>
        <dd>
          <time datetime={site.downloadPreview.date}>{releaseDateLabel}</time>
        </dd>
      </div>
    </dl>
    <a class="text-link" href={site.downloadPreview.releasesUrl}>
      GitHub Releases <Icon name="diagonal" size={16} />
    </a>
  </div>
  <div class="platform-grid">
    {downloadPlatforms.map((platform) => (
      <article class="platform-card ambient amb-surface amb-chamfer amb-elevation-0">
        <div class="platform-heading">
          <Icon name={platform.icon} size={36} />
          <div>
            <h3>{platform.name}</h3>
            <p id={`${platform.id}-status`}>{platform.status}</p>
          </div>
        </div>
        <dl class="platform-requirements">
          {platform.requirements.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {platform.id === 'macos' ? (
          <button
            type="button"
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            disabled
            aria-describedby={`${platform.id}-status`}
          >
            <Icon name="download" size={18} /> Coming soon
          </button>
        ) : (
          <a
            href={site.downloadPreview.releasesUrl}
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            aria-describedby={`${platform.id}-status`}
          >
            <Icon name="download" size={18} /> Download for {platform.name}
          </a>
        )}
      </article>
    ))}
  </div>
  <p class="download-note">
    Downloads will be published on GitHub Releases. These are current build
    targets; final system requirements will accompany each release.
  </p>
  <div class="download-licensing" id="licensing">
    <div>
      <h3>
        Licensing, <em>simply.</em>
      </h3>
      <p>A few answers before you get started.</p>
      <a class="text-link" href={licence.href}>
        Read the full agreement <Icon size={16} />
      </a>
      <a class="text-link" href={licensingAction.href}>
        {licensingAction.label} <Icon size={16} />
      </a>
    </div>
    <div class="faq-list">
      {licensingFaqs.map((item) => (
        <details>
          <summary>
            {item.question}
            <Icon name="plus" size={18} />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
