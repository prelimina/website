---
import Icon from './Icon.astro';
import site from '../content/site.json';
import { downloadPlatforms } from '../content/content';
const releaseDateLabel = new Date(site.downloadPreview.date).toLocaleDateString(
  'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
---

<section class="section container download-section" id="download">
  <div class="section-heading">
    <div>
      <h2>
        Download <em>desktop app.</em>
      </h2>
      <p class="download-intro">
        Free for noncommercial use. Commercial licences available.
      </p>
    </div>
  </div>
  <div class="release-summary ambient amb-surface-concave amb-chamfer-2 amb-elevation-0">
    <dl>
      <div>
        <dt>Current version</dt>
        <dd>v{site.downloadPreview.version}</dd>
      </div>
      <div>
        <dt>Release date</dt>
        <dd>
          <time datetime={site.downloadPreview.date}>{releaseDateLabel}</time>
        </dd>
      </div>
      <div>
        <dt>Changes</dt>
        <dd>
          <a class="text-link" href="/changelog/">
            Changelog <Icon size={16} />
          </a>
        </dd>
      </div>
    </dl>
    <a class="text-link" href={site.downloadPreview.releasesUrl}>
      See all releases <Icon name="diagonal" size={16} />
    </a>
  </div>
  <div class="platform-grid">
    {downloadPlatforms.map((platform) => (
      <article class="platform-card ambient amb-surface-concave amb-chamfer amb-elevation-0">
        <div class="platform-heading">
          <Icon name={platform.icon} size={36} />
          <div>
            <h3>{platform.name}</h3>
          </div>
        </div>
        <dl class="platform-requirements">
          {platform.requirements.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {platform.id === 'macos' ? (
          <button
            type="button"
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            disabled
          >
            <Icon name="download" size={18} /> Coming soon
          </button>
        ) : (
          <a
            href={site.downloadPreview.releasesUrl}
            class="button platform-download ambient amb-surface-convex amb-mat-matte amb-fillet-2"
          >
            <Icon name="download" size={18} /> Download for {platform.name}
          </a>
        )}
      </article>
    ))}
  </div>
  <p class="section-note">
    Provisional hardware targets, based on a source assessment and testing on
    Windows 11 with an NVIDIA RTX 5070 Ti. Entry-level GPUs, low-memory systems,
    and Linux have not yet been qualified. RAM and VRAM are separate
    requirements; larger scenes may need more of both. Vulkan support alone does
    not guarantee compatibility with every solver.
  </p>
</section>
