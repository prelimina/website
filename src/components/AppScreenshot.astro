---
import Icon from './Icon.astro';
import { browserAction } from '../content/content';
// A real capture of the desktop app, so visitors see what they would actually use.
const files = [
  ['640', 640],
  ['1280', 1280],
  ['full', 2538],
] as const;
const src = (name: string) => `/assets/app/prelimina-simulate-${name}.webp`;
---

<section class="section container app-section" id="desktop-app">
  <div class="section-heading app-section-heading">
    <h2>
      Any platform. <em>Full power.</em>
    </h2>
    <p>
      Run it in your browser or on the desktop, with the same GPU solver
      behind both. Set up the case and watch the flow and the probe readings
      update together.
    </p>
  </div>
  <figure class="app-shot">
    <a href={src('full')} class="app-shot-frame">
      <img
        src={src('1280')}
        srcset={files.map(([name, w]) => `${src(name)} ${w}w`).join(', ')}
        sizes="(min-width: 1280px) 1216px, calc(100vw - 32px)"
        width="2538"
        height="1427"
        loading="lazy"
        decoding="async"
        alt="The Prelimina window in the Simulate tab: the Kishev sloshing tank seen from the side with a wave coloured by speed running up the right wall, display settings on the left, and below it the pressure at probe P1 over the run with the measured pressure from the experiment drawn over it as a grey reference curve."
      />
    </a>
    <figcaption>
      Live probe pressure (blue) against the measured pressure of Hu, Kashiwagi
      &amp; Kishev (2004), grey.
    </figcaption>
  </figure>
  <div class="app-actions">
    <a
      href={browserAction.href}
      class="button ambient amb-surface-convex amb-mat-matte amb-fillet-2"
    >
      Use it in the browser <Icon name="diagonal" size={18} />
    </a>
    <a
      href="/#download"
      class="button ambient amb-surface-convex amb-mat-matte amb-fillet-2"
    >
      Download for desktop <Icon name="diagonal" size={18} />
    </a>
  </div>
</section>
