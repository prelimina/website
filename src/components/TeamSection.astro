---
import Icon from './Icon.astro';
import { team } from '../content/content';
---

<section class="section container team-section" id="team">
  <div class="team-intro">
    <h2 set:html={team.title} />
    <p>{team.description}</p>
    <a class="text-link" href={team.link.href} rel="noopener">
      {team.link.label} <Icon name="diagonal" size={16} />
    </a>
  </div>
  <dl class="team-facts">
    {team.facts.map((fact) => (
      <div class="team-fact">
        <dt>
          <span class="team-fact-value">{fact.value}</span>
          <span class="team-fact-label">{fact.label}</span>
        </dt>
        <dd>{fact.description}</dd>
      </div>
    ))}
  </dl>
</section>
