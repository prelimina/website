---
import Icon from './Icon.astro';
import FlowBackdrop from './FlowBackdrop.astro';
import { capabilityGroups } from '../content/capabilities';
---

<section class="section container capability-summary band" id="capabilities">
  <FlowBackdrop seed={1} />
  <div class="section-heading">
    <h2>
      From moving liquid
      <br />
      to <em>better decisions.</em>
    </h2>
  </div>
  <div class="capability-summary-grid">
    {capabilityGroups.map((group) => (
      <a
        class="capability-card"
        href={`/capabilities/#${group.id}`}
      >
        <div class="capability-card-heading">
          <span class="capability-icon ambient amb-mat-glass">
            <Icon name={group.icon} size={28} />
          </span>
          <h3>{group.summaryTitle}</h3>
        </div>
        <p>{group.summary}</p>
        <span class="capability-card-link">
          {group.title}
          <Icon size={16} />
        </span>
      </a>
    ))}
  </div>
  <div class="section-action">
    <a
      class="button button-primary ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      href="/capabilities/"
    >
      Explore all capabilities <Icon size={18} />
    </a>
    <p>See the full feature list and the maturity of each capability.</p>
  </div>
</section>
