---
import Icon from './Icon.astro';
import FlowBackdrop from './FlowBackdrop.astro';
import { capabilityGroups, maturity, type CapabilityGroup } from '../content/capabilities';
---

<section class="section container capability-summary band" id="capabilities">
  <FlowBackdrop seed={1} />
  <div class="section-heading">
    <h2>
      What the <em>solver does.</em>
    </h2>
  </div>
  <div class="capability-summary-grid">
    {capabilityGroups.map((group: CapabilityGroup) => (
      <a
        class="capability-card"
        href={`/capabilities/#${group.id}`}
      >
        <div class="capability-card-heading">
          <span class="capability-icon ambient amb-mat-glass">
            <Icon name={group.icon} size={28} />
          </span>
          <h3>{group.summaryTitle}</h3>
        </div>
        {group.summaryStatus && (
          <span class="maturity-badge" data-maturity={group.summaryStatus}>
            {maturity[group.summaryStatus].label}
          </span>
        )}
        <p>{group.summary}</p>
      </a>
    ))}
  </div>
  <div class="section-action">
    <a
      class="button ambient amb-surface-convex amb-mat-matte amb-fillet-2"
      href="/capabilities/"
    >
      Explore all capabilities <Icon size={18} />
    </a>
    <p>Full feature list, with the status of each one.</p>
  </div>
</section>
