---
import Icon from './Icon.astro';
import ShowcaseMedia from './ShowcaseMedia.astro';
import { showcases } from '../content/content';
interface Props {
  item: (typeof showcases)[number];
}
const { item } = Astro.props;
---

<a class="showcase-card" href={`/showcases/${item.slug}/`}>
  <div class="showcase-visual">
    <ShowcaseMedia
      illustration={item.type}
      media={item.media && { ...item.media, caption: undefined }}
      aspectRatio="48 / 29"
    />
  </div>
  <div class="showcase-copy">
    <span class="showcase-category">{item.category}</span>
    <h3>{item.title}</h3>
    <p>{item.description}</p>
    <span class="text-link">
      View application <Icon />
    </span>
  </div>
</a>
