---
import '@ambientcss/css/ambient.css';
import '../styles/global.css';
import site from '../content/site.json';
import { browserAction, docsMenu, footerColumns, nav, productActionConfig } from '../content/content';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'GPU-native CFD for moving liquids and early-stage design',
  description = 'Explore sloshing, baffle layouts, and free-surface motion with Prelimina, a GPU-native CFD application for desktop and browser, in development for early-stage design.',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonicalUrl = new URL(path, 'https://prelimina.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#000000" />
    <title>{title} — Prelimina</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prelimina" />
    <meta property="og:title" content={`${title} — Prelimina`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_black_white.svg" />
    <link
      rel="preload"
      href="/assets/Fraunces-Soft.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/assets/Quicksand-Variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
  </head>
  <body class="amb-light-tl">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Prelimina home">
          <img
            src="/assets/logo_black_white.svg"
            width="48"
            height="48"
            alt=""
          />
          <span>Prelimina</span>
        </a>
        <button
          class="menu-toggle ambient amb-surface-convex amb-mat-matte amb-fillet-2"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          Menu <span aria-hidden="true">☰</span>
        </button>
        <nav id="main-navigation" aria-label="Main navigation">
          <a class="nav-link" href={nav[0].href}>{nav[0].label}</a>
          <details class="nav-menu">
            <summary
              class:list={[
                'nav-link',
                { 'is-current': docsMenu.some((link) => path === link.href || path.startsWith(link.href)) },
              ]}
            >
              Docs
            </summary>
            <div class="nav-menu-panel">
              {docsMenu.map((link) => (
                <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          </details>
          {nav.slice(1).map((link) => (
            <a class="nav-link" href={link.href}>{link.label}</a>
          ))}
          <a
            class="header-cta ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            href={browserAction.href}
          >
            {browserAction.label} <Icon name="diagonal" size={15} />
          </a>
          <a
            class="header-cta ambient amb-surface-convex amb-mat-matte amb-fillet-2"
            href={productActionConfig.href}
          >
            {productActionConfig.label} <Icon name="diagonal" size={15} />
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a href="/" class="brand">
            <img
              src="/assets/logo_black_white.svg"
              width="36"
              height="36"
              alt=""
            />
            <span>Prelimina</span>
          </a>
          <p>Fluid insight for your next design iteration.</p>
        </div>
        <div class="footer-links">
          {footerColumns.map((column) => (
            <div class="footer-column">
              {column.heading.href ? (
                <a class="footer-heading" href={column.heading.href}>{column.heading.label}</a>
              ) : (
                <span class="footer-heading">{column.heading.label}</span>
              )}
              {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          ))}
        </div>
      </div>
      <div class="container footer-bottom">
        <span>Developed by {site.company}</span>
        <span class="preview-label">
          <i></i> PRE-RELEASE · IN DEVELOPMENT
        </span>
        <span>© {new Date().getFullYear()} Prelimina</span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(expanded));
        nav?.classList.toggle('is-open', expanded);
      });
      nav?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          nav.classList.remove('is-open');
        }),
      );
      const docs = document.querySelector<HTMLDetailsElement>('.nav-menu');
      document.addEventListener('click', (event) => {
        if (docs?.open && !docs.contains(event.target as Node)) docs.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && docs?.open) {
          docs.open = false;
          docs.querySelector('summary')?.focus();
          return;
        }
        if (
          event.key === 'Escape' &&
          toggle?.getAttribute('aria-expanded') === 'true'
        ) {
          toggle.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('is-open');
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
